# Copy to .env (PowerShell: Copy-Item .env.example .env)

# Change for anything beyond a local demo.
JWT_SECRET=dev-secret-change-me

# Demo mode: the SMS code is shown on screen and in the api log (no real SMS).
DEV_MODE=true

# --- AI -----------------------------------------------------------------------
# mock   = keyword rules, no model needed (default)
# ollama = Ollama                          -> AI_BASE_URL=http://host.docker.internal:11434
# openai = LM Studio / llama.cpp / vLLM    -> AI_BASE_URL=http://host.docker.internal:1234  (port of that server)
# legalai = LegalAI server (rules + Uzbek laws + Ollama) -> AI_BASE_URL=http://host.docker.internal:8000
#           AI_API_KEY = LEGALAI_API_KEY from the LegalAI .env; AI_TIMEOUT_SECONDS=900
#
# "host.docker.internal" = the computer Docker runs on. Use it when the AI runs on the
# same machine; do NOT use "localhost" (inside Docker that means the container itself).
# For an AI on another computer, put its IP instead, e.g. http://192.168.1.50:11434
AI_PROVIDER=mock
AI_BASE_URL=http://host.docker.internal:11434
# Exact model name as the AI server lists it (`ollama list`, or the model id in LM Studio).
AI_MODEL=gemma3:4b
AI_API_KEY=
AI_TIMEOUT_SECONDS=300

FREE_REVIEWS=3
PACKAGE_REVIEWS=10
PACKAGE_PRICE_UZS=25000
